  "narrative": {
    "northStar": "The Network Room",
    "overview": "The interface is a room where the network is on the wall. Stations are drawn where they really are, coloured by what they are doing, and everything else (panels, type, chrome) stays quiet enough that the data is the loudest thing on screen. It is dark because it is meant to be read on a projector in a dim room or on a laptop at the end of a day, not because dark is a default.\n\nThe language is wayfinding, not dashboards-with-glow: hairline rules, ring stations, a transit-style line for the data path, signage-weight headings. Colour is spent on meaning. Six state colours are the only saturated hues on screen; the primary action is a light button, not a neon accent. Motion explains the live system (a packet travelling, a station changing state, a truck driving a transfer) and goes calm under `prefers-reduced-motion`.",
    "keyCharacteristics": [
      "Ink ground, hairline panels, no shadows at rest.",
      "State colours are the data language: vide, saturée, faible, élevée, normale, hors service.",
      "Figures in a mono face with tabular numerals; headings in a characterful grotesque.",
      "Truth shown, not styled away: freshness (live / en retard / périmé) is always visible."
    ],
    "rules": [
      {
        "name": "The Meaning Rule",
        "body": "A saturated colour on screen is a station state or a status. Decoration never borrows them.",
        "section": "colors"
      },
      {
        "name": "The Light Primary Rule",
        "body": "The main action is the lightest object in the room (Text on Ground), never a coloured button.",
        "section": "colors"
      },
      {
        "name": "The Measured Mono Rule",
        "body": "Mono is for numbers, times and codes. Never for \"technical\" decoration.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "No shadow on a resting panel. A shadow means \"this floats above the map\".",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do show data age and its cause next to every number that could be stale.",
      "Do keep state colours in the validated order and pair them with a label or count.",
      "Do animate transform and opacity; ease out with cubic-bezier(0.23, 1, 0.32, 1); keep UI transitions under 300ms.",
      "Do provide a calm `prefers-reduced-motion` variant for every animation."
    ],
    "donts": [
      "Don't use a state colour for decoration or a coloured primary button.",
      "Don't add eyebrow labels above headings, thick side stripes, gradient text, or glyphs standing in for icons.",
      "Don't present stale or missing data as fresh; show absence as absence.",
      "Don't animate layout properties (width, height, margin, padding); use grid-template-rows, transform or opacity."
    ]
  }
