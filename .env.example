# Copy to .env (never commit .env). Used by docker compose and by host-side runs.

# --- GBFS source (Naolib / Nantes Métropole, GBFS 2.3, transport.data.gouv.fr) ---
GBFS_DISCOVERY_URL=https://api.cyclocity.fr/contracts/nantes/gbfs/gbfs.json
GBFS_SOURCE_NAME=naolib-nantes
GBFS_LANGUAGE=fr
# Offline fallback: set to tests/fixtures/gbfs to read local JSON files instead of HTTP.
GBFS_FIXTURE_DIR=
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=10
# Seconds between two refreshes of station_information (static: names, coordinates).
STATION_INFO_REFRESH_SECONDS=3600

# --- Kafka ---
# Host-side address (EXTERNAL listener). Containers always use kafka:9092.
# KAFKA_HOST_PORT must match the port below (it is the port published on your machine).
KAFKA_HOST_PORT=39092
KAFKA_BOOTSTRAP_SERVERS=localhost:39092
KAFKA_TOPIC=gbfs.station_status.v1
KAFKA_TOPIC_PARTITIONS=3

# --- Spark web UIs (host ports; 8080/8081 are often taken by other local stacks) ---
SPARK_MASTER_UI_PORT=18080
SPARK_WORKER_UI_PORT=18081
SPARK_DRIVER_UI_PORT=14040
SPARK_SILVER_UI_PORT=14041

# --- Spark Structured Streaming ---
SPARK_TRIGGER_INTERVAL=30 seconds
SPARK_MAX_OFFSETS_PER_TRIGGER=10000
# earliest = read the whole topic the first time (ignored once a checkpoint exists)
SPARK_STARTING_OFFSETS=earliest

# --- Silver ---
# Deduplication horizon, measured on arrival time (ingestion_timestamp). A duplicate arriving
# later than this after its first copy is kept.
SILVER_WATERMARK_DELAY=24 hours
SILVER_MAX_FILES_PER_TRIGGER=50

# --- Gold ---
# Days of 15-minute series / hourly rates recomputed at each run (older partitions are kept).
GOLD_SERIES_DAYS=7

# --- PostgreSQL + Grafana (phase 4) ---
# SECRETS: replace every "change-me" in your own .env (never commit it). Compose refuses to
# start if a password is empty. Generate one e.g. with: openssl rand -base64 24
POSTGRES_DB=mobilitypulse
POSTGRES_USER=mobilitypulse
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=15432
# Read-only role created by the loader; it is the only account Grafana uses.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_HOST_PORT=13000
# Dashboard UI (service `web`, reads PostgreSQL with the read-only role above).
WEB_HOST_PORT=18000
# Optional: link shown on the landing page ("Code source et README"). http(s) only; empty = API docs.
PROJECT_REPO_URL=

# --- Live path (docs/architecture.md) ---
# Seconds between two checks for new Silver files by the live-updater.
LIVE_INTERVAL_SECONDS=10
# Seconds between two runs of the Gold job (15-minute series, hourly rates) by gold-refresher.
GOLD_REFRESH_SECONDS=900
# Seconds between two reads of the database for the /api/stream (SSE) push, while a client listens.
STREAM_POLL_SECONDS=2

# --- Misc ---
LOG_LEVEL=INFO
