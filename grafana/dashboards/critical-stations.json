    {
      "id": 5,
      "type": "stat",
      "title": "Data as of",
      "datasource": {
        "type": "postgres",
        "uid": "mobilitypulse-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mobilitypulse-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (extract(epoch FROM max(as_of)) * 1000)::bigint AS \"as_of\" FROM mobility.v_station_state",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
