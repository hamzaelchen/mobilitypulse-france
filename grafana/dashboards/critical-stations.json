        }
      },
      "description": "Reference time of the last Gold computation loaded in PostgreSQL."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Critical stations",
      "description": "Empty / full / out-of-service stations, empty first. 'Hours in this state' counts from the last observed change of the station's counters. When 'Observed since' is ticked, no change has been seen since the pipeline started watching it: the real age is at least this value. A station can legitimately stay empty for hours (e.g. at night).",
      "datasource": {
        "type": "postgres",
        "uid": "mobilitypulse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "mobilitypulse-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT critical_type AS \"Type\", station_name AS \"Station\", num_bikes_available AS \"Bikes\", num_docks_available AS \"Docks\", capacity AS \"Capacity\", round(hours_in_current_state::numeric, 1) AS \"Hours in this state\", state_age_is_lower_bound AS \"Observed since (lower bound)\" FROM mobility.v_station_state WHERE critical_type IS NOT NULL ORDER BY CASE critical_type WHEN 'empty' THEN 1 WHEN 'full' THEN 2 ELSE 3 END, hours_in_current_state DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Type"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "empty": {
                        "color": "red",
                        "index": 0
                      },
                      "full": {
                        "color": "purple",
                        "index": 1
                      },
                      "out_of_service": {
                        "color": "gray",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
