            "uid": "mobilitypulse-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (extract(epoch FROM max(computed_at)) * 1000)::bigint AS \"computed_at\" FROM mobility.rebalancing_priority",
          "refId": "A"
        }
      ],
